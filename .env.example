# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=""

# Database & Cache Configurations
MONGODB_URI="mongodb://localhost:27017/ai_interview_db"
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="super_secret_jwt_key_change_in_production"
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Microservice Inter-Service URLs
AI_AGENT_SERVICE_URL="http://localhost:8000"
AUTH_SERVICE_URL="http://localhost:5001"
INTERVIEW_SERVICE_URL="http://localhost:5002"
GATEWAY_PORT=5000

# Rate Limiting Controls
RATE_LIMIT_WINDOW_SECS=60
RATE_LIMIT_MAX_REQUESTS=30

# Optional Online Code Runner (Judge0 API)
JUDGE0_API_KEY=""
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"

